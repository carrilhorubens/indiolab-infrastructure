      async def permission_checker(
          current_user: User = Depends(get_current_user),
          db: Session = Depends(get_db)
      ) -> User:
          # Buscar permissions do user via role
          user_permissions = db.query(UserPermission).join(...).filter(...).all()
          permission_names = [p.name for p in user_permissions]

          # Verificar se tem ALGUMA das permissions requeridas
          if not any(perm in permission_names for perm in required_permissions):
              raise HTTPException(403, detail=f"Permissões requeridas: {required_permissions}")

          return current_user
