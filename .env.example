# IndioLab — .env de produção (template)
#
# COPIAR para /opt/indiolab/.env no servidor e PREENCHER.
# NUNCA commitar o arquivo real (gitignored).

# ============================================
# PostgreSQL
# ============================================
POSTGRES_PASSWORD=<gerar via openssl rand -base64 32>
ConnectionStrings__DefaultConnection=Host=localhost;Database=opticalcore;Username=opticalcore;Password=<igual ao POSTGRES_PASSWORD>;Pooling=true;Maximum Pool Size=200

# ============================================
# JWT RS256 — IdP em-process via erp-api
# ============================================
# Gerar com:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
#   Cole o conteúdo PEM completo (incluindo BEGIN/END), entre aspas, com \n preservado.
JWT_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ============================================
# S2S internal — admin → satélites (catalog sync)
# ============================================
# Cada par (admin + satélite) compartilha o mesmo secret.
# Gerar com: openssl rand -base64 48
INTERNAL_SHARED_SECRET_ERP=<openssl rand -base64 48>
INTERNAL_SHARED_SECRET_CRM=<openssl rand -base64 48>
INTERNAL_SHARED_SECRET_CHAT=<openssl rand -base64 48>

# ============================================
# Integrações externas
# ============================================
GOOGLE_MAPS_API_KEY=<obtido no Google Cloud Console>

# ============================================
# n8n
# ============================================
# CRÍTICO: backup obrigatório. Sem essa chave, todos os credentials do n8n
# ficam inutilizáveis após restore. NUNCA alterar depois de criada.
N8N_ENCRYPTION_KEY=<openssl rand -hex 32>
